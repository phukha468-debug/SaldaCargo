# =============================================================================
# SALDA Platform — Шаблон переменных окружения (.env.example)
# Скопируйте в .env.local (и в apps/web/.env.local, apps/miniapp/.env.local)
# Никогда не коммитьте реальные токены и пароли в Git!
# =============================================================================

# --- Core: Supabase (обязательные) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# --- App URLs (CORS и редиректы) ---
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_MINIAPP_URL=http://localhost:3001

# --- Безопасность Cron, сессий, шифрования и Private Beta онбординга ---
AUTH_SESSION_SECRET=
CRON_SECRET=
ENCRYPTION_MASTER_KEY=
# Инвайт-код для создания новых организаций (/onboarding). Если пусто — регистрация закрыта.
ORG_REGISTRATION_INVITE_CODE=

# --- Интеграция: MAX Bot / Mini App (опционально) ---
MAX_BOT_TOKEN=
MAX_OAUTH_CLIENT_ID=
MAX_OAUTH_CLIENT_SECRET=
NEXT_PUBLIC_MAX_BOT_USERNAME=

# --- Интеграция: Т-Банк Open API (опционально) ---
TBANK_API_TOKEN=
TBANK_ACCOUNT_NUMBER=

# --- Интеграция: Opti24 / Газпромнефть (опционально) ---
OPTI24_API_URL=
OPTI24_LOGIN=
OPTI24_PASSWORD_HASH=
OPTI24_API_KEY=

# --- Интеграция: Wialon GPS (опционально) ---
WIALON_HOST=https://host.local4.wialon.host
WIALON_TOKEN=
WIALON_BASE_LAT=58.053
WIALON_BASE_LON=60.552
WIALON_BASE_RADIUS_METERS=8000

# --- Интеграция: Яндекс.Карты (опционально) ---
YANDEX_MAPS_API_KEY=

# --- Интеграция: Email SMTP (опционально, dev-фоллбэк; в production настраивается в БД) ---
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=

# --- Мониторинг ошибок (Sentry, опционально) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Деплой статического сайта REG.RU (только локальный скрипт scripts/deploy/) ---
REGRU_SFTP_HOST=
REGRU_SFTP_PORT=22
REGRU_SFTP_USER=
REGRU_SFTP_PASS=
